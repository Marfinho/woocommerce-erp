# Haster/Lindenweg16 DHL-Druck-Client – Konfiguration
#
# Diese Datei nach .env kopieren und ausfüllen:
#   cp .env.example .env
#
# Der Pi braucht ausschließlich diese vier Angaben, um zu funktionieren –
# unabhängig davon, in welchem Netzwerk er gerade steht. Ein Umzug in ein
# anderes Netzwerk (Haus A -> Haus B -> Büro -> Lager) erfordert keine
# Änderung an WordPress, solange der Pi Internetzugang hat.

# Adresse der WordPress-Installation, ohne abschließenden Schrägstrich.
WORDPRESS_URL=https://example.com

# Bearer-Token dieses Druckers, aus Lindenweg16 -> Betrieb -> DHL Drucker.
# Wird beim Anlegen bzw. bei "Token neu erzeugen" einmalig im Klartext
# angezeigt.
API_TOKEN=change-me

# Stabiler Schlüssel dieses Druckers (muss mit der Drucker-ID im Admin
# übereinstimmen), z. B. eg_dhl, office_dhl, warehouse_dhl.
PRINTER_ID=eg_dhl

# Name des lokal in CUPS eingerichteten Druckers (siehe README, Schritt 4).
# Nur relevant bei PRINT_BACKEND=cups (Standard) - bei brother_ql ignoriert.
PRINTER_NAME=DHL_PRINTER

# --- Druckweg (Backend) ------------------------------------------------
# "cups" (Standard): PDF unveraendert per lp/CUPS an PRINTER_NAME.
#
# "brother_ql": Direktdruck per USB an einen Brother-QL-Etikettendrucker,
# ohne CUPS/PPD - fuer Modelle, die CUPS/Gutenprint nicht unterstuetzen
# (z. B. QL-710W). Siehe README, Abschnitt "Brother QL ueber brother_ql
# (ohne CUPS)".
PRINT_BACKEND=cups

# Nur bei PRINT_BACKEND=brother_ql relevant:
BROTHER_QL_MODEL=QL-710W

# Bezeichner des Etikettenformats wie bei brother_ql - muss zur
# eingelegten Rolle passen. DK-11201 (29x90mm, gestanzt) = 29x90,
# DK-11209 (62x29mm, gestanzt) = 62x29, DK-22205 (endlos, 62mm breit) = 62.
BROTHER_QL_LABEL=29x90

# usb://<idVendor>:<idProduct>[/<Seriennummer>] - mit `lsusb` ermitteln
# (Zeile "ID 04f9:XXXX Brother Industries, Ltd"). Bei mehreren
# USB-Brother-Druckern am selben Pi zusaetzlich die Seriennummer angeben,
# um sie zu unterscheiden.
BROTHER_QL_USB_IDENTIFIER=usb://0x04f9:0x2043

# --- Long Polling -----------------------------------------------------
# Long Polling ist der normale Betriebsmodus. LONG_POLL_ENABLED=false ist
# nur zu Debugging-/Fallback-Zwecken gedacht.
LONG_POLL_ENABLED=true

# Wie lange der Server je Anfrage auf einen neuen Job wartet (Sekunden).
# Der Server begrenzt diesen Wert serverseitig ohnehin auf 5-30.
LONG_POLL_TIMEOUT=25

# HTTP-Timeout des Clients – muss größer sein als LONG_POLL_TIMEOUT, sonst
# bricht der Client die Verbindung vor der Serverantwort ab.
REQUEST_TIMEOUT=35

# Obergrenze für den exponentiellen Backoff bei Netzwerkfehlern (Sekunden).
MAX_RETRY_DELAY=30

# Nur relevant, wenn LONG_POLL_ENABLED=false: klassisches Intervall-Polling.
FALLBACK_POLL_INTERVAL=10

# --- Sonstiges ----------------------------------------------------------
# Verzeichnis, in dem heruntergeladene Labels zwischengespeichert werden.
DOWNLOAD_DIRECTORY=/var/lib/haster-print

# DEBUG, INFO, WARNING oder ERROR.
LOG_LEVEL=INFO
