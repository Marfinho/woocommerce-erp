# Haster/Lindenweg16 Bambu-Lab-Bridge – Konfiguration
#
# Diese Datei nach .env.bambu kopieren und ausfüllen:
#   cp .env.bambu.example .env.bambu

# Adresse der WordPress-Installation, ohne abschließenden Schrägstrich.
WORDPRESS_URL=https://example.com

# Bearer-Token dieses Druckers, aus Lindenweg16 -> Betrieb ->
# Bambu-Lab-Drucker. Wird beim Anlegen bzw. bei "Token neu erzeugen"
# einmalig im Klartext angezeigt.
API_TOKEN=change-me

# Stabiler Schlüssel dieses Druckers (muss mit der Drucker-ID im Admin
# übereinstimmen), z. B. bambu_p1s_1.
PRINTER_ID=bambu_p1s_1

# --- Verbindung zum Drucker (LAN-Modus) --------------------------------
# Am Drucker unter Einstellungen -> LAN-Modus zu finden. Bridge und
# Drucker müssen im selben Netzwerk stehen - anders als beim
# Etikettendrucker-Client reicht hier kein reiner Internetzugang, weil
# MQTT und FTPS direkt zum Drucker gehen, nicht über WordPress.

# IP-Adresse des Druckers im lokalen Netz. Eine feste Reservierung im
# Router (DHCP-Reservierung) verhindert, dass sich die Adresse nach
# einem Neustart des Druckers ändert.
BAMBU_IP=192.168.1.50

# LAN-Zugangscode, steht direkt unter der IP-Adresse am Display.
BAMBU_ACCESS_CODE=12345678

# Seriennummer des Druckers, ebenfalls am Display unter LAN-Modus zu
# finden (Format z. B. 01P00A000000000).
BAMBU_SERIAL=01P00A000000000

# --- Long Polling zu WordPress -----------------------------------------
LONG_POLL_TIMEOUT=25
REQUEST_TIMEOUT=35
MAX_RETRY_DELAY=30

# Wie oft der zuletzt vom Drucker gelesene Status an WordPress gemeldet
# wird (Sekunden) - dient zugleich als Online-Heartbeat.
STATUS_INTERVAL=10

# --- Sonstiges ----------------------------------------------------------
# Verzeichnis, in dem heruntergeladene 3MF-Dateien zwischengespeichert werden.
DOWNLOAD_DIRECTORY=/var/lib/bambu-bridge

# DEBUG, INFO, WARNING oder ERROR.
LOG_LEVEL=INFO
