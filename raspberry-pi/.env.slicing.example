# Haster/Lindenweg16 Headless-Slicing-Worker – Konfiguration
#
# Diese Datei nach .env.slicing kopieren und ausfüllen:
#   cp .env.slicing.example .env.slicing

# Adresse der WordPress-Installation, ohne abschließenden Schrägstrich.
WORDPRESS_URL=https://example.com

# Worker-Token, aus Lindenweg16 -> Betrieb -> Bambu-Lab-Drucker ->
# Reiter "Slicing-Profile" -> "Token neu erzeugen". Wird nur einmalig im
# Klartext angezeigt. Anders als bei den Druckern gibt es hier nur EIN
# geteiltes Token für den (typischerweise einen) Slicing-Worker.
API_TOKEN=change-me

# --- Slicer --------------------------------------------------------------
# Pfad zum Kommandozeilenprogramm (OrcaSlicer oder Bambu Studio im
# CLI-Modus). Unter Linux z. B. der Pfad zur AppImage oder zum
# entpackten Programm.
#
# Im Docker-Image (slicing-worker.Dockerfile) ist das schon richtig
# gesetzt (/usr/local/bin/orca-slicer, ein xvfb-Wrapper) - hier
# auskommentiert lassen, sonst überschreibt diese Zeile den Docker-Wert.
# Nur bei manueller Installation (siehe README) einkommentieren und
# anpassen:
# SLICER_CLI=/usr/bin/orca-slicer

# Verzeichnis mit den Herstellerprofilen der OrcaSlicer-Installation
# (enthält BBL.json und den Ordner BBL/ mit machine/, filament/, process/).
# Der Worker löst damit die Vererbung ("inherits") der in WordPress
# hochgeladenen Profile auf - ein exportiertes Benutzerprofil ist meist nur
# eine Differenzdatei zum Systemprofil, und der OrcaSlicer-CLI kann eine
# lose Datei mit "inherits" nicht laden (Fehler -5).
#
# Im Docker-Image schon richtig gesetzt (/opt/orca-profiles) - hier
# auskommentiert lassen. Nur bei manueller Installation einkommentieren,
# bei einer entpackten AppImage z. B. <Entpackordner>/resources/profiles:
# ORCA_PROFILES_DIR=/opt/orcaslicer/resources/profiles

# Wie lange ein einzelner Slice-Lauf höchstens dauern darf (Sekunden),
# bevor der Worker ihn abbricht und als fehlgeschlagen meldet.
SLICER_TIMEOUT=600

# Aufrufvorlage für den Slicer - normalerweise NICHT anpassen, der
# eingebaute Standard passt zu OrcaSlicer 2.x (2.4.2 geprüft):
#   {input} --load-settings {printer};{process} --load-filaments {filament}
#   --arrange 1 --slice 1 --allow-newer-file --outputdir {workdir} --export-3mf {output}
#   --debug 2 --logfile {logfile}
# Platzhalter: {input} Projekt-3MF, {printer}/{process}/{filament} die
# drei Profil-JSON, {output} DATEINAME der Ergebnis-3MF (landet in
# {workdir}, weil OrcaSlicer --outputdir vor den Exportpfad hängt),
# {workdir} Arbeitsverzeichnis des Auftrags, {logfile} Slicer-Logdatei.
# Nur einkommentieren, wenn eine andere Slicer-Version andere Flags
# verlangt ("orca-slicer --help" zeigt die gültigen):
# SLICER_ARGS_TEMPLATE={input} --load-settings {printer};{process} --load-filaments {filament} --arrange 1 --slice 1 --allow-newer-file --outputdir {workdir} --export-3mf {output} --debug 2 --logfile {logfile}

# Wie oft ein Download (Platte, Profile) bei Netzfehlern wiederholt wird,
# bevor der Auftrag als fehlgeschlagen an WordPress gemeldet wird.
DOWNLOAD_ATTEMPTS=3

# Arbeitsverzeichnisse fehlgeschlagener Aufträge (Eingabedateien,
# slicer.log, result.json, slicer-output.txt) bleiben so viele Tage zur
# Diagnose liegen; erfolgreiche werden sofort gelöscht. 0 = sofort.
KEEP_FAILED_JOBS_DAYS=7

# --- Polling zu WordPress -------------------------------------------------
# Wie bei der Bambu-Bridge: Standard ist klassisches Intervall-Polling,
# nicht Long Polling (manche Webhosting-Pakete kappen lang offen
# gehaltene Verbindungen vorzeitig). Bei Bedarf umstellen:
LONG_POLL_ENABLED=false
LONG_POLL_TIMEOUT=25
# 0 = sofort antworten, kein PHP-Worker wird serverseitig blockiert (siehe
# SlicingJobRepository::clamp_wait() auf der PHP-Seite). Nur bei
# LONG_POLL_ENABLED=true relevant zu ändern.
SHORT_POLL_WAIT=0
FALLBACK_POLL_INTERVAL=5
REQUEST_TIMEOUT=35
MAX_RETRY_DELAY=30

# --- Sonstiges ------------------------------------------------------------
# Arbeitsverzeichnis für heruntergeladene Platten, Profile und
# Slicing-Ergebnisse.
#
# Im Docker-Image schon richtig gesetzt (/data, als Volume gemountet) -
# hier auskommentiert lassen, sonst überschreibt diese Zeile den
# Docker-Wert. Nur bei manueller Installation einkommentieren:
# DOWNLOAD_DIRECTORY=/var/lib/slicing-worker

# DEBUG, INFO, WARNING oder ERROR.
LOG_LEVEL=INFO
